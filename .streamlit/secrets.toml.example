# Copy this file to .streamlit/secrets.toml for LOCAL development,
# or paste these same keys into Streamlit Cloud's "Secrets" panel
# for production. NEVER commit the real secrets.toml (see .gitignore).

PGHOST = "localhost"
PGPORT = "5432"
PGDATABASE = "school_saas"
PGUSER = "postgres"
PGPASSWORD = "your-password-here"

# Alternative: a single connection string (checked first if both are set)
# DATABASE_URL = "postgresql://user:password@host:5432/dbname"

SECRET_KEY = "change-this-to-a-random-string"
